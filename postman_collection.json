{
  "info": {
    "name": "Semantic Classification API",
    "description": "API para procesamiento documental y análisis territorial socioambiental",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "opencode"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "document_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "source_canonical_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "target_canonical_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET Root",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            },
            "description": "Verificar que la API está corriendo"
          },
          "response": []
        },
        {
          "name": "GET Health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Health check de la API"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "POST Create Document",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/documents",
              "host": ["{{base_url}}"],
              "path": ["documents"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "",
                  "description": "Archivo a subir (PDF, DOCX, etc.)"
                },
                {
                  "key": "incubator_number",
                  "type": "text",
                  "value": "1",
                  "description": "Incubadora del documento (1 a 8)"
                },
                {
                  "key": "language",
                  "type": "text",
                  "value": "es",
                  "description": "Idioma del documento (por ejemplo: es, en, pt)"
                },
                {
                  "key": "year",
                  "type": "text",
                  "value": "2025",
                  "description": "(Opcional) Año del documento, con cuatro dígitos. Puede completarse después."
                },
                {
                  "key": "productive_sector",
                  "type": "text",
                  "value": "Agroforestry",
                  "description": "(Opcional) Sector productivo controlado; actualmente solo Agroforestry"
                },
                {
                  "key": "document_type",
                  "type": "text",
                  "value": "technical_report",
                  "description": "(Opcional) academic, technical_report, project_report, policy_document, manual_or_guide, institutional_document u other"
                },
                {
                  "key": "metadata",
                  "type": "text",
                  "value": "",
                  "description": "(Opcional) JSON con metadata del documento"
                }
              ]
            },
            "description": "Subir un documento individual. Año, sector y tipo documental pueden omitirse y completarse después."
          },
          "response": []
        },
        {
          "name": "POST Batch Upload",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/documents/batch",
              "host": ["{{base_url}}"],
              "path": ["documents", "batch"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": "",
                  "description": "Múltiples archivos (PDF, DOCX). Usar el mismo key 'files' para todos."
                },
                {
                  "key": "incubator_number",
                  "type": "text",
                  "value": "1",
                  "description": "Incubadora común para todo el lote (1 a 8)"
                },
                {
                  "key": "language",
                  "type": "text",
                  "value": "es",
                  "description": "Idioma común para todo el lote"
                },
                {
                  "key": "year",
                  "type": "text",
                  "value": "2025",
                  "description": "(Opcional) Año común para todo el lote, con cuatro dígitos"
                },
                {
                  "key": "productive_sector",
                  "type": "text",
                  "value": "Agroforestry",
                  "description": "(Opcional) Sector productivo común; actualmente solo Agroforestry"
                },
                {
                  "key": "document_type",
                  "type": "text",
                  "value": "technical_report",
                  "description": "(Opcional) Tipo documental común para todo el lote"
                }
              ]
            },
            "description": "Subir múltiples archivos con los mismos atributos de ingesta"
          },
          "response": []
        },
        {
          "name": "GET List Documents",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/documents?status_filter=",
              "host": ["{{base_url}}"],
              "path": ["documents"],
              "query": [
                {
                  "key": "status_filter",
                  "value": "",
                  "description": "(Opcional) Filtrar por status: raw, converted, cleaned, processed, failed"
                }
              ]
            },
            "description": "Listar todos los documentos, opcionalmente filtrados por estado"
          },
          "response": []
        },
        {
          "name": "GET Document by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/documents/{{document_id}}",
              "host": ["{{base_url}}"],
              "path": ["documents", "{{document_id}}"]
            },
            "description": "Obtener detalle de un documento específico"
          },
          "response": []
        },
        {
          "name": "PATCH Complete Document Classification",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{base_url}}/documents/{{document_id}}/classification",
              "host": ["{{base_url}}"],
              "path": ["documents", "{{document_id}}", "classification"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "year",
                  "type": "text",
                  "value": "2025",
                  "description": "(Opcional) Año del documento, entre 1990 y 2030"
                },
                {
                  "key": "productive_sector",
                  "type": "text",
                  "value": "Agroforestry",
                  "description": "(Opcional) Sector productivo controlado"
                },
                {
                  "key": "document_type",
                  "type": "text",
                  "value": "technical_report",
                  "description": "(Opcional) Tipo documental controlado"
                }
              ]
            },
            "description": "Completar o corregir uno o varios atributos sin reprocesar el documento. Debe enviarse al menos un campo."
          },
          "response": []
        },
        {
          "name": "POST Process Document",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/documents/{{document_id}}/process",
              "host": ["{{base_url}}"],
              "path": ["documents", "{{document_id}}", "process"]
            },
            "description": "Convertir documento a texto plano (PDF/DOCX → TXT)"
          },
          "response": []
        },
        {
          "name": "POST Clean Document",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/documents/{{document_id}}/clean?dry_run=false",
              "host": ["{{base_url}}"],
              "path": ["documents", "{{document_id}}", "clean"],
              "query": [
                {
                  "key": "dry_run",
                  "value": "false",
                  "description": "true = solo métricas sin escribir archivos ni actualizar DB"
                }
              ]
            },
            "description": "Limpiar texto del documento (Capas 1+2+2c+3+4)"
          },
          "response": []
        },
        {
          "name": "POST Extract Entities",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/documents/{{document_id}}/extract-entities",
              "host": ["{{base_url}}"],
              "path": ["documents", "{{document_id}}", "extract-entities"]
            },
            "description": "Extraer entidades NER del documento limpio (usa spaCy — pendiente migrar a XLM-RoBERTa)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Entities",
      "item": [
        {
          "name": "GET List Entities",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/entities?category_filter=&document_id=",
              "host": ["{{base_url}}"],
              "path": ["entities"],
              "query": [
                {
                  "key": "category_filter",
                  "value": "",
                  "description": "(Opcional) Filtrar por categoría: INSTITUCIÓN, LUGAR, ACTOR, COMUNIDAD, NARRATIVA, PRÁCTICA, ACCIÓN, INFRAESTRUCTURA, VALOR_ECOLÓGICO, MISC_Spacy"
                },
                {
                  "key": "document_id",
                  "value": "",
                  "description": "(Opcional) Filtrar por ID de documento"
                }
              ]
            },
            "description": "Listar entidades con filtros opcionales por categoría y documento"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Analysis",
      "item": [
        {
          "name": "POST Build Network by Filters",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"incubator_number\": 4,\n  \"language\": \"es\",\n  \"minimum_weight\": 1,\n  \"include_isolates\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/analysis/network",
              "host": ["{{base_url}}"],
              "path": ["analysis", "network"]
            },
            "description": "Construye una red plana. incubator_number y language aceptan un valor concreto o 'all'. Los filtros se combinan con AND."
          },
          "response": []
        },
        {
          "name": "POST Build Full Network",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/analysis/network",
              "host": ["{{base_url}}"],
              "path": ["analysis", "network"]
            },
            "description": "Sin body: construye el corpus completo con minimum_weight=1 e include_isolates=true."
          },
          "response": []
        },
        {
          "name": "GET Latest Network by Filters",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/analysis/network/latest?incubator_number=4&language=es&minimum_weight=1&include_isolates=true",
              "host": ["{{base_url}}"],
              "path": ["analysis", "network", "latest"],
              "query": [
                {"key": "incubator_number", "value": "4"},
                {"key": "language", "value": "es"},
                {"key": "minimum_weight", "value": "1"},
                {"key": "include_isolates", "value": "true"}
              ]
            },
            "description": "Recupera sin recalcular la red generada para la combinación exacta de filtros y parámetros."
          },
          "response": []
        },
        {
          "name": "POST Build Typed PRAC INFRA RUL Projection",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"incubator_number\": \"all\",\n  \"language\": \"all\",\n  \"minimum_weight\": 1,\n  \"include_isolates\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/analysis/network/projections/prac-infra-rul-v2",
              "host": ["{{base_url}}"],
              "path": ["analysis", "network", "projections", "prac-infra-rul-v2"]
            },
            "description": "Construye la proyección tipada PRAC + INFRA + RUL y sus nueve vistas sin sobrescribir la red histórica."
          },
          "response": []
        },
        {
          "name": "POST Build Document Recurrent Core",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"incubator_number\": \"all\",\n  \"language\": \"es\",\n  \"construction\": {\n    \"method\": \"document-recurrent-core-v1\",\n    \"minimum_node_document_count\": 2,\n    \"edge_weighting\": \"fractional-document\",\n    \"include_minor_components\": true\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/analysis/network/projections/prac-infra-rul-v2",
              "host": ["{{base_url}}"],
              "path": ["analysis", "network", "projections", "prac-infra-rul-v2"]
            },
            "description": "Construye el núcleo de entidades recurrentes por documento, calcula pesos analíticos y exporta vistas para todos los componentes y la componente principal."
          },
          "response": []
        },
        {
          "name": "GET Latest Typed Projection",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/analysis/network/projections/prac-infra-rul-v2/latest?incubator_number=all&language=all&minimum_weight=1&include_isolates=true",
              "host": ["{{base_url}}"],
              "path": ["analysis", "network", "projections", "prac-infra-rul-v2", "latest"],
              "query": [
                {"key": "incubator_number", "value": "all"},
                {"key": "language", "value": "all"},
                {"key": "minimum_weight", "value": "1"},
                {"key": "include_isolates", "value": "true"}
              ]
            },
            "description": "Lee la proyección tipada ya generada y devuelve URLs para la evidencia y las nueve vistas."
          },
          "response": []
        },
        {
          "name": "POST Calculate Leiden Clusters",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"incubator_number\": \"all\",\n  \"language\": \"es\",\n  \"construction\": {\n    \"method\": \"document-recurrent-core-v1\",\n    \"minimum_node_document_count\": 2,\n    \"edge_weighting\": \"fractional-document\",\n    \"include_minor_components\": true\n  },\n  \"component_scope\": \"main-component\",\n  \"view\": \"all\",\n  \"configuration\": {\n    \"method\": \"leiden-v1\",\n    \"objective_function\": \"modularity\",\n    \"resolution\": 1.0,\n    \"seed\": 42,\n    \"iterations\": -1,\n    \"weight_attribute\": \"weight\"\n  },\n  \"force_recompute\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/analysis/network/projections/prac-infra-rul-v2/clusterings/leiden",
              "host": ["{{base_url}}"],
              "path": ["analysis", "network", "projections", "prac-infra-rul-v2", "clusterings", "leiden"]
            },
            "description": "Calcula Leiden sobre una vista ya construida, genera un GraphML para Gephi con modularity_class y exporta el resumen de comunidades."
          },
          "response": []
        },
        {
          "name": "GET Typed Projection Views",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/analysis/network/projections/prac-infra-rul-v2/views",
              "host": ["{{base_url}}"],
              "path": ["analysis", "network", "projections", "prac-infra-rul-v2", "views"]
            },
            "description": "Enumera la vista completa, cruzada, intratipo y las seis vistas por category_pair."
          },
          "response": []
        },
        {
          "name": "GET Typed Edge Evidence",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/analysis/network/projections/prac-infra-rul-v2/edges/{{source_canonical_id}}/{{target_canonical_id}}/evidence?minimum_weight=1&limit=100&offset=0",
              "host": ["{{base_url}}"],
              "path": ["analysis", "network", "projections", "prac-infra-rul-v2", "edges", "{{source_canonical_id}}", "{{target_canonical_id}}", "evidence"],
              "query": [
                {"key": "minimum_weight", "value": "1"},
                {"key": "limit", "value": "100"},
                {"key": "offset", "value": "0"}
              ]
            },
            "description": "Recupera documentos, oraciones, contexto y entidades involucradas en una arista."
          },
          "response": []
        }
      ]
    }
  ]
}
