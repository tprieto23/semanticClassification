# Copiar a semanticClassification/.env en el EC2 y completar. Nunca subir a Git.

# RDS: endpoint que muestra la consola (Connectivity & security → Endpoint).
DATABASE_URL=postgresql://sc_admin:CAMBIAR_PASSWORD@CAMBIAR-ENDPOINT.us-east-2.rds.amazonaws.com:5432/semantic_db?sslmode=require

# Necesaria para limpieza lingüística y NER.
ANTHROPIC_API_KEY=

# IP elástica con guiones + .sslip.io (ej. 18.228.10.5 → 18-228-10-5.sslip.io).
GATEWAY_HOST=

# Procesos de la API (t3.medium: 2).
API_WORKERS=2
